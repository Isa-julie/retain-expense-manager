PORT=5000
# Local: mongodb://127.0.0.1:27017/retain   |   Hosted: your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/retain
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Frontend address(es) allowed to call this API, comma separated
CLIENT_URL=http://localhost:5173

# Used only by `npm run seed` to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
